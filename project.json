{
  "$schema": "../../schemas/project.schema.json",
  "name": "echobridge-farm",
  "type": "monorepo",
  "default_safety_tier": "dangerous",
  "owner_agent": "echobridge",
  "apps": ["echobridge"],
  "paths": {
    "runtime_dir": "apps/echobridge/.agent"
  },
  "hooks": {
    "prerequisites": "bash \"{{farmslot_dir}}/projects/echobridge-farm/setup/check-paths.sh\" \"{{repo}}\" \"{{platform}}\"",
    "setup": "yarn install --immutable",
    "preflight": "METRO_TMUX_SESSION=echobridge-metro-{{slot_id}} METRO_PORT={{metro_port}} WATCHER_PORT={{metro_port}} METRO_CONNECTION=localhost bash apps/echobridge/scripts/agentic/start-metro.sh",
    "health_check": "lsof -nP -iTCP:{{metro_port}} -sTCP:LISTEN >/dev/null 2>&1",
    "dev_server_check": "lsof -nP -iTCP:{{metro_port}} -sTCP:LISTEN >/dev/null 2>&1",
    "recipe_action_manifest": "cd \"{{repo}}/apps/echobridge\" && yarn recipe:echobridge manifest",
    "recipe_doctor": "cd \"{{repo}}/apps/echobridge\" && yarn recipe:doctor --json | node -e 'let s=\"\"; process.stdin.on(\"data\",d=>s+=d); process.stdin.on(\"end\",()=>{const d=JSON.parse(s); const pass=d.status===\"pass\"; console.log(JSON.stringify({runner_protocol_version:1,status:pass?\"pass\":\"fail\",checks:[{id:\"expo_recipe_doctor\",status:pass?\"pass\":\"fail\",message:\"@farmslot/expo-recipe doctor readiness\"}]}));})'",
    "recipe_run": "cd \"{{repo}}/apps/echobridge\" && PLATFORM='{{platform}}' IOS_SIMULATOR='{{simulator}}' ADB_SERIAL='{{adb_serial}}' CDP_PORT='{{cdp_port}}' bash scripts/agentic/validate-recipe.sh --recipe \"{{recipe_path}}\" --artifacts-dir \"{{artifacts_dir}}\" --runtime-dir \"{{runtime_dir}}\" --metro-port {{metro_port}}",
    "recycle": "xcrun simctl shutdown {{simulator}}"
  },
  "health": {
    "dev_server_log": "apps/echobridge/.agent/metro.log",
    "dev_server_name": "Metro"
  },
  "platforms": {
    "ios": {
      "device_check": "xcrun simctl list devices booted 2>/dev/null | grep -q '{{simulator}}'",
      "recycle": null
    },
    "android": {
      "device_check": "adb devices 2>/dev/null | grep -q '{{adb_serial}}'",
      "recycle": "adb -s {{adb_serial}} shell pm clear com.echobridge"
    }
  },
  "resources": {
    "ios-sim": {
      "type": "device",
      "platform": "ios",
      "label": "iOS Sim",
      "streamable": true,
      "controllable": true,
      "watch": {
        "type": "process-poll",
        "provider": "ios-simulator-inventory",
        "target": "{{simulator}}",
        "cmd": "xcrun simctl list devices booted 2>/dev/null | grep -q '{{simulator}}'"
      },
      "hooks": {
        "health": "xcrun simctl list devices booted 2>/dev/null | grep -q '{{simulator}}'",
        "boot": "xcrun simctl boot '{{simulator}}'",
        "shutdown": "xcrun simctl shutdown '{{simulator}}'"
      }
    },
    "android-emu": {
      "type": "device",
      "platform": "android",
      "label": "Android Emu",
      "streamable": true,
      "controllable": true,
      "watch": { "type": "process-poll", "cmd": "adb -s {{adb_serial}} get-state 2>/dev/null | grep -q device" },
      "hooks": {
        "health": "adb -s {{adb_serial}} get-state 2>/dev/null | grep -q device",
        "boot": "\"$ANDROID_HOME/emulator/emulator\" -avd {{avd}} &",
        "shutdown": "adb -s {{adb_serial}} emu kill"
      }
    },
    "dev-server": {
      "type": "dev-server",
      "label": "Metro",
      "streamable": false,
      "controllable": true,
      "watch": { "type": "port-listen", "port": "{{metro_port}}" },
      "hooks": {
        "health": "lsof -nP -iTCP:{{metro_port}} -sTCP:LISTEN >/dev/null 2>&1",
        "shutdown": "lsof -ti :{{metro_port}} 2>/dev/null | xargs kill 2>/dev/null; true"
      }
    }
  },
  "recipe_run_supports_playback_slow": false,
  "recipe_run_supports_video_recording": false
}
